{
  "expo": {
    "name": "Black Label Connect",
    "slug": "black-label-connect",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "scheme": "blacklabel",
    "primaryColor": "#090A0C",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.blacklabelbranding.connect",
      "buildNumber": "1",
      "icon": "./assets/connect-icon.png",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.blacklabelbranding.connect",
      "versionCode": 1,
      "permissions": [],
      "predictiveBackGestureEnabled": false,
      "adaptiveIcon": {
        "foregroundImage": "./assets/connect-icon.png",
        "backgroundColor": "#090A0C"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./public/favicon.png"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "defaultChannel": "default",
          "enableRemoteNotifications": true
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "652840aa-94e0-484f-a4a5-d887c703de95"
      }
    },
    "icon": "./assets/connect-icon.png"
  }
}
